generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  isPremium     Boolean   @default(false)
  premiumUntil  DateTime?
  plan          String    @default("free") // free, pro, whale
  role          String    @default("user") // user, admin
  trialUses     Int       @default(0)      // Contador de usos de prueba (máximo 2)
  trialExpired  Boolean   @default(false)  // Bandera de trial expirado
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  calculations  Calculation[]
  payments      Payment[]
  purchases     ProductPurchase[]
}

model Calculation {
  id          String   @id @default(cuid())
  userId      String
  centerPrice Float
  resistances String   // JSON string of resistance levels
  supports    String   // JSON string of support levels
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id            String   @id @default(cuid())
  name          String
  price         Float
  duration      Int      // days
  features      String   // JSON string
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  pagoparHash   String?
  userId        String
  planType      String   // pro, whale
  billingPeriod String   @default("monthly") // monthly, yearly
  amount        Int
  currency      String   @default("PYG")
  amountUsd     Float
  status        String   @default("pending") // pending, paid, failed
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductPurchase {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  orderId     String    @unique
  pagoparHash String?
  price       Float
  status      String    @default("pending") // pending, paid, failed
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuantumAccess {
  id         String   @id @default(cuid())
  visitorKey String   @unique
  usesCount  Int      @default(0)
  userId     String?
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model TrialUsage {
  id        String   @id @default(cuid())
  ipAddress String
  userId    String
  useCount  Int      @default(0)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([ipAddress, userId])
  @@index([ipAddress])
}

model PriceLevel {
  id        String   @id @default(cuid())
  asset     String
  price     Float
  type      String   // "strong_resistance", "resistance", "pivot", "support", "strong_support"
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeSignal {
  id        String   @id @default(cuid())
  asset     String
  direction String   // "BUY", "SELL"
  entry     Float
  tp        Float
  sl        Float
  status    String   @default("active") // "active", "hit_tp", "hit_sl", "closed"
  result    Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // "downloads", "free_material", "brokers", "education"
  imageUrl    String?
  downloadUrl String?
  externalUrl String?
  content     String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuantumLiveLevel {
  id        String   @id @default(cuid())
  asset     String
  maxPrice  Float
  minPrice  Float
  levels    Json     // Array de los 9 niveles calculados
  isActive  Boolean  @default(true)
  touches   Json?    // Registro de toques [{level: "Q3", time: "...", type: "bounce", pips: 12}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryResult {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String   @db.Text  // Text para soportar base64
  tool        String   // "hexagono", "serie144", "cuadrado9", "quantum", "gann"
  asset       String   // "XAU/USD", "BTC/USD", etc.
  date        DateTime
  accuracy    String?  // "Rebote exacto", "+85 pips", etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
