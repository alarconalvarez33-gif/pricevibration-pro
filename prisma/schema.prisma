generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  password           String
  isPremium          Boolean   @default(false)
  premiumUntil       DateTime?
  plan               String    @default("free") // free, quantum
  role               String    @default("user") // user, admin
  trialUses          Int       @default(0)
  trialExpired       Boolean   @default(false)
  cursoPurchased     Boolean   @default(false)
  whatsapp           String?
  signalsViewed      Int       @default(0)
  subscriptionStatus String    @default("inactive") // inactive, active, cancelled, expired
  autoRenew          Boolean   @default(true)
  cancelledAt        DateTime?
  nextBillingDate    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  calculations       Calculation[]
  payments           Payment[]
  purchases          ProductPurchase[]
  subscriptionLogs   SubscriptionLog[]
  licenses           License[]
}

model License {
  id                String    @id @default(cuid())
  code              String    @unique
  productType       String    // "metalevels" | "quantum" | etc

  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentId         String?

  status            String    @default("active") // active | revoked | expired

  issuedAt          DateTime  @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedReason     String?

  pineScriptVersion String    @default("v1.0")

  @@index([code])
  @@index([userId])
  @@index([status])
  @@index([productType])
}

model SubscriptionLog {
  id        String   @id @default(cuid())
  userId    String
  event     String   // activated, cancelled, reactivated, expired, reminder_sent
  plan      String?
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Calculation {
  id          String   @id @default(cuid())
  userId      String
  centerPrice Float
  resistances String   // JSON string of resistance levels
  supports    String   // JSON string of support levels
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id            String   @id @default(cuid())
  name          String
  price         Float
  duration      Int      // days
  features      String   // JSON string
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  pagoparHash   String?
  userId        String
  planType      String   // pro, whale
  billingPeriod String   @default("monthly") // monthly, yearly
  amount        Int
  currency      String   @default("PYG")
  amountUsd     Float
  status        String   @default("pending") // pending, paid, failed
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductPurchase {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  orderId     String    @unique
  pagoparHash String?
  price       Float
  status      String    @default("pending") // pending, paid, failed
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuantumAccess {
  id         String   @id @default(cuid())
  visitorKey String   @unique
  usesCount  Int      @default(0)
  userId     String?
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model TrialUsage {
  id        String   @id @default(cuid())
  ipAddress String
  userId    String
  useCount  Int      @default(0)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([ipAddress, userId])
  @@index([ipAddress])
}

model PriceLevel {
  id        String   @id @default(cuid())
  asset     String
  price     Float
  type      String   // "strong_resistance", "resistance", "pivot", "support", "strong_support"
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeSignal {
  id        String   @id @default(cuid())
  asset     String
  direction String   // "BUY", "SELL"
  entry     Float
  tp        Float
  sl        Float
  status    String   @default("active") // "active", "hit_tp", "hit_sl", "closed"
  result    Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // "downloads", "free_material", "brokers", "education"
  imageUrl    String?
  downloadUrl String?
  externalUrl String?
  content     String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuantumLiveLevel {
  id        String   @id @default(cuid())
  asset     String
  maxPrice  Float
  minPrice  Float
  levels    Json     // Array de los 9 niveles calculados
  isActive  Boolean  @default(true)
  touches   Json?    // Registro de toques [{level: "Q3", time: "...", type: "bounce", pips: 12}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryResult {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String   @db.Text  // Text para soportar base64
  tool        String   // "hexagono", "serie144", "cuadrado9", "quantum", "gann"
  asset       String   // "XAU/USD", "BTC/USD", etc.
  date        DateTime
  accuracy    String?  // "Rebote exacto", "+85 pips", etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Proof {
  id        String   @id @default(cuid())
  imageUrl  String   @db.Text
  caption   String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Reservation {
  id        String   @id @default(cuid())
  email     String   @unique
  whatsapp  String?
  createdAt DateTime @default(now())
}

model WebhookLog {
  id           String   @id @default(cuid())
  provider     String   // "pagopar"
  numeroPedido String?
  hashPedido   String?
  payload      Json
  response     Json?
  status       String   // "processing" | "processed" | "duplicate" | "not_found" | "cancelled" | "failed"
  errorMsg     String?
  userEmail    String?
  createdAt    DateTime @default(now())

  @@index([numeroPedido])
  @@index([hashPedido])
  @@index([createdAt])
  @@index([status])
}

model ActivationLog {
  id          String   @id @default(cuid())
  paymentId   String
  userId      String
  product     String
  source      String   // "webhook" | "admin_manual"
  triggeredBy String   // "pagopar_webhook" | admin email
  success     Boolean
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([source])
}

model ReconciliationLog {
  id              String   @id @default(cuid())
  paymentId       String
  paymentType     String   @default("subscription") // "subscription" | "product"
  userId          String
  pagoparStatus   String
  previousStatus  String
  newStatus       String
  action          String   // "activated" | "no_action" | "error"
  source          String   // "cron" | "manual_admin"
  errorMsg        String?
  pagoparResponse Json?
  createdAt       DateTime @default(now())

  @@index([paymentId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model FreeUsage {
  id          String   @id @default(cuid())
  fingerprint String
  ip          String
  usageCount  Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fingerprint, ip])
  @@index([fingerprint])
  @@index([ip])
}

model ProofResult {
  id          String   @id @default(cuid())
  imageData   String   @db.Text    // base64 encoded image (Vercel-safe storage)
  mimeType    String   @default("image/jpeg")
  description String
  date        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
