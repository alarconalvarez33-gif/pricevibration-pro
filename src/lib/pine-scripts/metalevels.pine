  licenseKey == "SL-ML-X7HQ67KJE4R9" or
  licenseKey == "SL-ML-DL5VGD4T52LT" or
  licenseKey == "SL-ML-Z97SA5XUWFGP" or
  licenseKey == "SL-ML-UFBJLLSZUGXC" or
  licenseKey == "SL-ML-ABDCZ87ZHJVN" or
  licenseKey == "SL-ML-NVDBHZ4J8DDC" or
  licenseKey == "SL-ML-86MKNP7MHRW7" or
  licenseKey == "SL-ML-KM9MZCQM6QQW" or
